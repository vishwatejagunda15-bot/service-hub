# Application Environment (development | production)
NODE_ENV=development
PORT=3000

# MySQL Database Connection URL for Prisma:
# Local MySQL:        mysql://<username>:<password>@127.0.0.1:3306/servicehub
# TiDB Cloud Starter: mysql://<username>:<password>@<host>:4000/servicehub?sslaccept=strict&connection_limit=5
# Other Cloud MySQL:  mysql://<username>:<password>@<host>:<port>/servicehub?sslaccept=strict
DATABASE_URL=mysql://root:your-mysql-password@127.0.0.1:3306/servicehub

# Individual MySQL parameters (used only if DATABASE_URL is omitted):
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=servicehub

# JWT signing secret (generate a 64+ character random secret for production):
JWT_SECRET=replace-this-with-a-long-random-secret

# Allowed frontend client origins (comma-separated, no trailing slashes):
# Production example: https://servicehub.yourdomain.com
CLIENT_ORIGIN=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://127.0.0.1:3000

# Optional variables used ONLY when running "npm run admin:create":
# ADMIN_NAME=ServiceHub Admin
# ADMIN_EMAIL=admin@yourdomain.com
# ADMIN_PASSWORD=replace-with-strong-password-min-10-chars
