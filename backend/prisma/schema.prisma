datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

model Customer {
  id           Int       @id @default(autoincrement())
  fullName     String    @db.VarChar(80)
  email        String    @unique @db.VarChar(254)
  phone        String    @db.VarChar(20)
  passwordHash String    @db.VarChar(255)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  bookings     Booking[]

  @@map("customers")
}

model Provider {
  id              Int       @id @default(autoincrement())
  fullName        String    @db.VarChar(80)
  email           String    @unique @db.VarChar(254)
  phone           String    @db.VarChar(20)
  passwordHash    String    @db.VarChar(255)
  serviceCategory String    @db.VarChar(50)
  location        String    @db.VarChar(100)
  experience      Int       @default(0)
  charges         Decimal   @default(0.00) @db.Decimal(10, 2)
  availability    String    @db.VarChar(80)
  description     String    @db.Text
  about           String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  bookings        Booking[]

  @@index([serviceCategory])
  @@index([location])
  @@index([serviceCategory, location])
  @@index([createdAt])
  @@map("providers")
}

model Booking {
  id                           Int      @id @default(autoincrement())
  customerId                   Int
  providerId                   Int
  customerName                 String   @db.VarChar(80)
  customerPhone                String   @db.VarChar(20)
  address                      String   @db.VarChar(250)
  serviceCategory              String   @db.VarChar(50)
  bookingDate                  String   @db.VarChar(10)
  bookingTime                  String   @db.VarChar(5)
  description                  String   @db.Text
  status                       String   @default("Pending") @db.VarChar(20)
  confirmedProviderArrivalDate String   @default("") @db.VarChar(10)
  confirmedProviderArrivalTime String   @default("") @db.VarChar(5)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([providerId])
  @@index([status])
  @@index([bookingDate])
  @@index([customerId, createdAt])
  @@index([providerId, createdAt])
  @@map("bookings")
}

model Admin {
  id           Int      @id @default(autoincrement())
  fullName     String   @db.VarChar(80)
  email        String   @unique @db.VarChar(254)
  passwordHash String   @db.VarChar(255)
  role         String   @default("admin") @db.VarChar(20)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admins")
}
