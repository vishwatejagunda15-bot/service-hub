{
  "name": "servicehub",
  "version": "1.0.0",
  "private": true,
  "description": "ServiceHub local home-service marketplace (Frontend + Express/Prisma/MySQL API)",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "npm --prefix backend run dev",
    "start": "npm --prefix backend start",
